generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model recipe_tags {
  recipe_id String
  tag_id    String
  recipes   recipes @relation(fields: [recipe_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tags      tags    @relation(fields: [tag_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([recipe_id, tag_id])
}

model recipes {
  id          String        @id
  title       String
  ingredients String[]
  steps       String[]
  created_at  DateTime?     @default(now()) @db.Timestamp(6)
  user_id     String?
  recipe_tags recipe_tags[]
  users       users?        @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id])
}

model tags {
  id          String        @id
  name        String        @unique
  recipe_tags recipe_tags[]
}

model users {
  id            String    @id
  email         String    @unique
  password_hash String
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  recipes       recipes[]
}
